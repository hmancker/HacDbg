;
; ProcessIoctlDrv.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=
CatalogFile=ProcessIoctlDrv.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
ProcessIoctlDrv.sys=1

[DefaultInstall.NTamd64]
CopyFiles=ProcessIoctlDrv.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService=ProcessIoctlDrv,0x00000002,ProcessIoctlDrv.Service

[ProcessIoctlDrv.DriverFiles]
ProcessIoctlDrv.sys

[ProcessIoctlDrv.Service]
DisplayName="ProcessIoctlDrv"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\ProcessIoctlDrv.sys

[Strings]
ManufacturerName="HacDbg"
DiskName="ProcessIoctlDrv"
