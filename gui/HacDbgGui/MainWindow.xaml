<ui:FluentWindow x:Class="HacDbgGui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                 xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                 xmlns:controls="clr-namespace:HacDbgGui.Controls"
                 xmlns:dockTheme="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
                 xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
                 Title="HacDbg"
                 Width="1600"
                 Height="900"
                 MinWidth="1200"
                 MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource WindowBackgroundBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 Loaded="MainWindow_Loaded"
                 Closing="MainWindow_Closing"
                 PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="HacDbg" />

        <Border Grid.Row="1"
                Margin="12,4,12,10"
                Padding="10,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="ContinueButton" Content="继续 (F5)" Click="ContinueButton_Click" IsEnabled="False" />
                <Button x:Name="StepIntoButton" Content="单步进入 (F11)" Click="StepIntoButton_Click" IsEnabled="False" />
                <Button x:Name="StepOverButton" Content="单步跳过 (F10)" Click="StepOverButton_Click" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="取消当前命令" Click="CancelButton_Click" IsEnabled="False" />
                <Button x:Name="LoadSymbolsButton" Content="加载符号" Click="LoadSymbolsButton_Click" IsEnabled="False" />
                <Button x:Name="RefreshViewsButton" Content="刷新视图" Click="RefreshViewsButton_Click" IsEnabled="False" />
                <Button x:Name="ClearButton"
                        Content="清空输出 (Ctrl+L)"
                        Click="ClearButton_Click"
                        ToolTip="清空命令台输出，不改变寄存器、断点或客户状态。" />
                <Button x:Name="ResetLayoutButton"
                        Content="重置布局"
                        Click="ResetLayoutButton_Click"
                        ToolTip="把所有文档恢复到默认的单页选项卡布局并立即保存。" />
                <Button x:Name="SearchButton"
                        Content="搜索 (Ctrl+F)"
                        Click="SearchButton_Click"
                        ToolTip="在命令台输出中查找。F3 下一个，Shift+F3 上一个。" />
                <Button x:Name="ThemeButton"
                        Content="亮色主题"
                        Click="ThemeButton_Click"
                        ToolTip="在暗色和亮色主题之间切换，并记住选择。" />
                <TextBlock Text="Ctrl+Tab 切换视图 · Ctrl+1–7 直达 · Esc 输入命令 · Tab 补全"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12" />
                <StackPanel x:Name="SymbolProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="SymbolProgressBar"
                                 Width="150"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource SurfaceRaisedBrush}"
                                 BorderThickness="0" />
                    <TextBlock x:Name="SymbolProgressText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="640" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="命令台"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid x:Name="CommandSearchBar"
                          Grid.Row="1"
                          Margin="0,0,0,8"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CommandSearchBox"
                                 ToolTip="在命令台输出中查找，不区分大小写。"
                                 KeyDown="CommandSearchBox_KeyDown"
                                 TextChanged="CommandSearchBox_TextChanged" />
                        <Button Grid.Column="1"
                                Content="上一个"
                                Click="CommandSearchPrevious_Click"
                                ToolTip="Shift+F3" />
                        <Button Grid.Column="2"
                                Content="下一个"
                                Click="CommandSearchNext_Click"
                                ToolTip="F3" />
                        <TextBlock x:Name="CommandSearchStatus"
                                   Grid.Column="3"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="4"
                                Content="关闭"
                                Click="CommandSearchClose_Click" />
                    </Grid>

                    <avalonEdit:TextEditor x:Name="CommandOutput"
                                           Grid.Row="2"
                                           IsReadOnly="True"
                                           ShowLineNumbers="False"
                                           WordWrap="False"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           Background="{StaticResource SurfaceBrush}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           BorderThickness="0"
                                           Padding="4"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="kd&gt;"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource AccentBrush}" />

                        <TextBox x:Name="CommandInput"
                                 Grid.Column="1"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="13"
                                 IsEnabled="False"
                                 ToolTip="Tab 补全当前命令，点击列表中的一项即可填入。上下键切换历史，Enter 执行。"
                                 KeyDown="CommandInput_KeyDown"
                                 PreviewKeyDown="CommandInput_PreviewKeyDown"
                                 TextChanged="CommandInput_TextChanged" />

                        <Popup x:Name="CompletionPopup"
                               PlacementTarget="{Binding ElementName=CommandInput}"
                               Placement="Top"
                               VerticalOffset="-4"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=CommandInput}"
                                    MaxWidth="560">
                                <ListBox x:Name="CompletionList"
                                         MaxHeight="240"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         PreviewMouseLeftButtonUp="CompletionList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}"
                                                                CornerRadius="4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                <Setter Property="Cursor" Value="Arrow" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <avalonDock:DockingManager x:Name="DockManager"
                                       Grid.Column="2"
                                       Background="{StaticResource SurfaceBrush}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       AllowFloatingWindows="False"
                                       AllowMixedOrientation="True"
                                       IsVirtualizingAnchorable="True"
                                       IsVirtualizingDocument="True"
                                       ShowNavigator="False"
                                       GridSplitterWidth="6">
                <avalonDock:DockingManager.Theme>
                    <themes:Vs2013DarkTheme />
                </avalonDock:DockingManager.Theme>
                <avalonDock:DockingManager.Resources>
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.Background}"
                                     Color="{DynamicResource SurfaceColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.PanelBorderBrush}"
                                     Color="{DynamicResource BorderColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.TabBackground}"
                                     Color="{DynamicResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabSelectedActiveBackground}"
                                     Color="{DynamicResource SurfaceRaisedColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabSelectedActiveText}"
                                     Color="{DynamicResource ForegroundColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabSelectedInactiveBackground}"
                                     Color="{DynamicResource SurfaceColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabSelectedInactiveText}"
                                     Color="{DynamicResource MutedColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabUnselectedBackground}"
                                     Color="{DynamicResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabUnselectedText}"
                                     Color="{DynamicResource MutedColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}"
                                     Color="{DynamicResource SurfaceRaisedColor}" />
                    <SolidColorBrush x:Key="{x:Static dockTheme:ResourceKeys.DocumentWellTabUnselectedHoveredText}"
                                     Color="{DynamicResource ForegroundColor}" />
                </avalonDock:DockingManager.Resources>
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane>
                <avalonDock:LayoutDocument x:Name="StatusTab"
                                           Title="状态"
                                           ContentId="status"
                                           CanClose="False"
                                           CanFloat="False">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="寄存器"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <DataGrid x:Name="RegisterGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="寄存器" Binding="{Binding Name}" Width="110" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Changed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2"
                                           Text="标志"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,4" />

                                <ItemsControl x:Name="FlagsGrid" Grid.Row="3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,4"
                                                    Padding="6,2"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               HorizontalAlignment="Right"
                                                               Margin="10,0,0,0"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows" />

                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="断点"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <DataGrid x:Name="BreakpointGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="170" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="55" />
                                        <DataGridTextColumn Header="暂停" Binding="{Binding Pause}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="ModulesTab"
                                           Title="模块"
                                           ContentId="modules"
                                           CanClose="False"
                                           CanFloat="False">
                    <Border Margin="0,6,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="模块"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ModulesStatusText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Button Grid.Column="2"
                                        Content="刷新"
                                        Click="RefreshModulesButton_Click" />
                            </Grid>

                            <DataGrid x:Name="ModuleGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="ModuleGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="模块" Binding="{Binding Name}" Width="150" />
                                    <DataGridTextColumn Header="基址" Binding="{Binding Base}" Width="165" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="85" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="65" />
                                    <DataGridTextColumn Header="符号" Binding="{Binding Symbols}" Width="70" />
                                    <DataGridTextColumn Header="路径" Binding="{Binding SymbolPath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="ProcessesTab"
                                           Title="进程 / 线程"
                                           ContentId="processes"
                                           CanClose="False"
                                           CanFloat="False">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="进程"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="过滤"
                                               VerticalAlignment="Center"
                                               Margin="12,0,6,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="ProcessFilterBox"
                                             Grid.Column="2"
                                             Width="160"
                                             ToolTip="按 PID（十进制或 0x 十六进制）或进程名过滤"
                                             TextChanged="ProcessFilterBox_TextChanged" />
                                    <TextBlock x:Name="ProcessesStatusText"
                                               Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="8,0,12,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <Button Grid.Column="4"
                                            Content="刷新"
                                            Click="RefreshProcessesButton_Click" />
                                </Grid>

                                <DataGrid x:Name="ProcessGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          SelectionChanged="ProcessGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" />
                                        <DataGridTextColumn Header="映像" Binding="{Binding Image}" Width="145" />
                                        <DataGridTextColumn Header="父 PID" Binding="{Binding ParentPid}" Width="75" />
                                        <DataGridTextColumn Header="EPROCESS" Binding="{Binding Eprocess}" Width="170" />
                                        <DataGridTextColumn Header="CR3" Binding="{Binding UserCr3}" Width="170" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows" />

                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="线程"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="过滤"
                                               VerticalAlignment="Center"
                                               Margin="12,0,6,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="ThreadFilterBox"
                                             Grid.Column="2"
                                             Width="150"
                                             ToolTip="按 TID/PID（十进制或 0x 十六进制）或进程名过滤"
                                             TextChanged="ThreadFilterBox_TextChanged" />
                                    <TextBlock x:Name="ThreadsStatusText"
                                               Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Grid>

                                <DataGrid x:Name="ThreadGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          MouseDoubleClick="ThreadGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="65" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                                        <DataGridTextColumn Header="RIP" Binding="{Binding InstructionPointer}" Width="170" />
                                        <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="70" />
                                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="StackTab"
                                           Title="调用栈"
                                           ContentId="stack"
                                           CanClose="False"
                                           CanFloat="False">
                    <Border Margin="0,6,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="调用栈"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="StackStatusText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Button Grid.Column="2"
                                        Content="刷新"
                                        Click="RefreshStackButton_Click" />
                            </Grid>

                            <DataGrid x:Name="StackGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="StackGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                                    <DataGridTextColumn Header="Child-SP" Binding="{Binding ChildSp}" Width="165" />
                                    <DataGridTextColumn Header="返回地址" Binding="{Binding ReturnAddress}" Width="165" />
                                    <DataGridTextColumn Header="调用位置" Binding="{Binding Symbol}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="MemoryTab"
                                           Title="内存"
                                           ContentId="memory"
                                           CanClose="False"
                                           CanFloat="False">
                    <Border Margin="0,6,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="内存"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="MemoryStatusText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Button Grid.Column="2"
                                        Content="刷新"
                                        Click="MemoryRefreshButton_Click" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地址"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBox x:Name="MemoryAddressBox"
                                         Grid.Column="1"
                                         Text="0x0" />
                                <TextBlock Grid.Column="2"
                                           Text="CR3"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <TextBox x:Name="MemoryCr3Box"
                                         Grid.Column="3" />
                                <Button Grid.Column="4"
                                        Content="上一页"
                                        Click="MemoryPreviousButton_Click" />
                                <Button Grid.Column="5"
                                        Content="下一页"
                                        Click="MemoryNextButton_Click" />
                                <Button Grid.Column="6"
                                        Content="读取"
                                        Click="MemoryReadButton_Click" />
                            </Grid>

                            <DataGrid x:Name="MemoryGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="175" />
                                    <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="2*" />
                                    <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="DisassemblyTab"
                                           Title="反汇编"
                                           ContentId="disassembly"
                                           CanClose="False"
                                           CanFloat="False">
                    <Border Margin="0,6,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="反汇编"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DisassemblyStatusText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0"
                                           Foreground="{StaticResource MutedBrush}" />
                                <CheckBox x:Name="FollowRipCheck"
                                          Grid.Column="2"
                                          Content="跟随 RIP"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <Button Grid.Column="3"
                                        Content="RIP"
                                        Click="RipButton_Click" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地址"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBox x:Name="DisassemblyAddressBox"
                                         Grid.Column="1"
                                         Text="0x0" />
                                <TextBlock Grid.Column="2"
                                           Text="CR3"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <TextBox x:Name="DisassemblyCr3Box"
                                         Grid.Column="3" />
                                <ComboBox x:Name="DisassemblyCountBox"
                                          Grid.Column="4"
                                          Width="70"
                                          Margin="8,0"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="32" Tag="32" />
                                    <ComboBoxItem Content="64" Tag="64" />
                                    <ComboBoxItem Content="128" Tag="128" />
                                </ComboBox>
                                <Button Grid.Column="5"
                                        Content="上一页"
                                        Click="DisassemblyPreviousButton_Click" />
                                <Button Grid.Column="6"
                                        Content="下一页"
                                        Click="DisassemblyNextButton_Click" />
                                <Button Grid.Column="7"
                                        Content="读取"
                                        Click="DisassemblyReadButton_Click" />
                            </Grid>

                            <DataGrid x:Name="DisassemblyGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      MouseDoubleClick="DisassemblyGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="Auto" MinWidth="175" />
                                    <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="Auto" MinWidth="130" />
                                    <DataGridTextColumn Header="指令" Binding="{Binding Text}" Width="Auto" MinWidth="190" />
                                    <DataGridTemplateColumn Header="符号" Width="Auto" MinWidth="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Symbol}"
                                                           TextTrimming="None"
                                                           ToolTip="{Binding Symbol}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </avalonDock:LayoutDocument>

                <avalonDock:LayoutDocument x:Name="TraceTab"
                                           Title="实时 trace"
                                           ContentId="trace"
                                           CanClose="False"
                                           CanFloat="False">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="TraceCountersButton"
                                            Content="开启计数"
                                            Click="TraceCountersButton_Click"
                                            IsEnabled="False" />
                                    <Button x:Name="TraceEventsButton"
                                            Content="开启事件"
                                            Click="TraceEventsButton_Click"
                                            IsEnabled="False" />
                                    <Button x:Name="TraceStopButton"
                                            Content="停止"
                                            Click="TraceStopButton_Click"
                                            IsEnabled="False" />
                                    <Button x:Name="TraceResetButton"
                                            Content="重置"
                                            Click="TraceResetButton_Click"
                                            IsEnabled="False" />
                                    <Button x:Name="TraceExportButton"
                                            Content="导出 CSV"
                                            Click="TraceExportButton_Click"
                                            IsEnabled="False" />
                                    <TextBlock Text="采样"
                                               VerticalAlignment="Center"
                                               Margin="4,0,6,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="TraceSampleBox"
                                              Width="76"
                                              SelectedIndex="1"
                                              IsEnabled="False">
                                        <ComboBoxItem Content="1" Tag="1" />
                                        <ComboBoxItem Content="64" Tag="64" />
                                        <ComboBoxItem Content="256" Tag="256" />
                                    </ComboBox>
                                    <Button Content="返回命令台"
                                            Click="TraceReturnFocusButton_Click"
                                            Margin="12,0,0,0" />
                                </WrapPanel>

                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="事件模式会改变客户退出时序，可能被检测。DurationTsc 当前未采样，延迟直方图显示为不可用。" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TraceErrorText"
                                   Grid.Row="1"
                                   Margin="2,8,2,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="Collapsed" />

                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <controls:TraceHost x:Name="TraceViewHost" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TraceStatusText"
                                   Grid.Row="3"
                                   Margin="2,8,2,0"
                                   Text="实时 trace 未连接"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </avalonDock:LayoutDocument>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <Border Grid.Row="3"
                Margin="12,0,12,10"
                Padding="10,6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="未连接" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="PausedText" Grid.Column="1" Text="—" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="Cr3Text" Grid.Column="2" Text="CR3 —" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="VersionText" Grid.Column="4" Text="版本 —" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
