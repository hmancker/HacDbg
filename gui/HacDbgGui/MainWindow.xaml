<ui:FluentWindow x:Class="HacDbgGui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                 Title="HacDbg"
                 Width="1400"
                 Height="900"
                 MinWidth="1000"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource WindowBackgroundBrush}"
                 Loaded="MainWindow_Loaded"
                 Closing="MainWindow_Closing"
                 PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="HacDbg" />

        <Border Grid.Row="1"
                Margin="12,4,12,10"
                Padding="10,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ContinueButton" Content="继续 (F5)" Click="ContinueButton_Click" IsEnabled="False" />
                <Button x:Name="StepIntoButton" Content="单步进入 (F11)" Click="StepIntoButton_Click" IsEnabled="False" />
                <Button x:Name="StepOverButton" Content="单步跳过 (F10)" Click="StepOverButton_Click" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="取消当前命令" Click="CancelButton_Click" IsEnabled="False" />
                <Button x:Name="ClearButton" Content="清空输出" Click="ClearButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="命令台"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <avalonEdit:TextEditor x:Name="CommandOutput"
                                           Grid.Row="1"
                                           IsReadOnly="True"
                                           ShowLineNumbers="False"
                                           WordWrap="False"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           Background="{StaticResource SurfaceBrush}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           BorderThickness="0"
                                           Padding="4"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="kd&gt;"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource AccentBrush}" />

                        <TextBox x:Name="CommandInput"
                                 Grid.Column="1"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="13"
                                 IsEnabled="False"
                                 KeyDown="CommandInput_KeyDown"
                                 PreviewKeyDown="CommandInput_PreviewKeyDown" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="寄存器"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <DataGrid x:Name="RegisterGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="寄存器" Binding="{Binding Name}" Width="110" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="断点"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <DataGrid x:Name="BreakpointGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="170" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="55" />
                                <DataGridTextColumn Header="暂停" Binding="{Binding Pause}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="12,0,12,10"
                Padding="10,6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="未连接" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="PausedText" Grid.Column="1" Text="—" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="Cr3Text" Grid.Column="2" Text="CR3 —" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="VersionText" Grid.Column="4" Text="版本 —" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
