<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HacDbgGui</AssemblyName>
    <RootNamespace>HacDbgGui</RootNamespace>
    <Version>1.1.1</Version>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgGui\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <TrackFileWritesShareableOutsideOfProjectDirectory>true</TrackFileWritesShareableOutsideOfProjectDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)obj\publish-build\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
    <ProjectReference Include="..\..\usermode\HacDbgCore.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\HacDbgTrace\HacDbgTrace.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyNativeCore" AfterTargets="Build">
    <PropertyGroup>
      <_NativeDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\.'))</_NativeDir>
      <_OutDir>$([System.IO.Path]::GetFullPath('$(TargetDir).'))</_OutDir>
      <_SameNativeDir>$([System.String]::Equals($(_NativeDir), $(_OutDir), StringComparison.OrdinalIgnoreCase))</_SameNativeDir>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll') and '$(_SameNativeDir)' != 'True'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.pdb"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.pdb') and '$(_SameNativeDir)' != 'True'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.dll') and '$(_SameNativeDir)' != 'True'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.pdb"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.pdb') and '$(_SameNativeDir)' != 'True'" />
  </Target>
  <Target Name="CopyRuntimeFilesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgTrace.dll')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\usermode.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\usermode.exe')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
