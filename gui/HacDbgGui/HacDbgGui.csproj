<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HacDbgGui</AssemblyName>
    <RootNamespace>HacDbgGui</RootNamespace>
    <Version>1.0.19</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
    <ProjectReference Include="..\..\usermode\HacDbgCore.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyNativeCore" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.pdb"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.pdb')" />
  </Target>
  <Target Name="CopyRuntimeFilesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\HacDbgCore.dll')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\usermode.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\x64\$(Configuration)\usermode.exe')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
