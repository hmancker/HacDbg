;
; HacDbg.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=
CatalogFile=HacDbg.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
HacDbg.sys = 1

[DefaultInstall.NTamd64]
CopyFiles=HacDbg.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService=HacDbg,0x00000002,HacDbg.Service

[HacDbg.DriverFiles]
HacDbg.sys

[HacDbg.Service]
DisplayName="HacDbg"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\HacDbg.sys

[Strings]
ManufacturerName="HacDbg"
DiskName="HacDbg Source Disk"
